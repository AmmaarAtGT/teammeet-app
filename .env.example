# ========================================================
# TeamMeet — Railway Deployment Environment Variables
# ========================================================

PORT=3000
NODE_ENV=production

# LiveKit Cloud Credentials (from https://cloud.livekit.io/)
LIVEKIT_URL=wss://yourteam-xxxx.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxx
LIVEKIT_API_SECRET=secretxxxxxx

# Optional Team Passcode (leave blank for open access)
TEAM_PASSCODE=

# 24-Hour Room Tokens (Unlimited Duration, No 90-Min Limits)
TOKEN_TTL=24h
