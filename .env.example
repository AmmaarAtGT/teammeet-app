# ==============================================================================
# 🚀 TeamMeet — Railway & Production Deployment Environment Variables
# ==============================================================================
# Copy these variables into the "Variables" tab in your Railway Project Dashboard.
# You can also create a local .env file by copying this file: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER SETTINGS
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. LIVEKIT CLOUD WEBRTC (FREE TIER: 50 GB/Month)
# ------------------------------------------------------------------------------
# 1. Sign in at https://cloud.livekit.io/ with Google
# 2. Click "Create Project" -> Name it: TeamMeet
# 3. Go to Settings > Keys and copy these 3 credentials:
# (Note: LIVEKIT_URL must start with wss://)
LIVEKIT_URL=wss://yourteam-xxxxxx.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=secretxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 3. MEETING DURATION & RETENTION SETTINGS
# ------------------------------------------------------------------------------
# 24-Hour token duration ensures meetings never cut off at 90 minutes
TOKEN_TTL=24h

# Auto-Purge retention: server deletes recordings older than 15 days to save disk
PURGE_RETENTION_DAYS=15

# ------------------------------------------------------------------------------
# 4. OPTIONAL SECURITY & PASSCODE
# ------------------------------------------------------------------------------
# Optional passcode. If set, participants must enter this to join any meeting room.
# Leave blank for open team access without passcode.
TEAM_PASSCODE=

# ------------------------------------------------------------------------------
# 5. GOOGLE DRIVE SYNC (OPTIONAL)
# ------------------------------------------------------------------------------
# Paste the Google Drive folder link or folder ID where meeting recordings,
# whiteboard diagrams, and AI notes will be archived.
# Example: https://drive.google.com/drive/folders/1AbCdEfGhIjKlMnOpQrStUvWxYz
GOOGLE_DRIVE_FOLDER_ID=

# ------------------------------------------------------------------------------
# 6. AI MEETING NOTES
# ------------------------------------------------------------------------------
# 'on' enables on-demand meeting transcription and summaries (toggleable in UI)
# 'off' disables AI notes to save server CPU
AI_NOTES=on
