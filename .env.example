# ==============================================================================
# 🚀 TeamMeet — Enterprise Railway & Production Deployment Environment Variables
# ==============================================================================
# Copy these variables into the "Variables" tab in your Railway Project Dashboard.
# You can also create a local .env file by copying this file: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER SETTINGS
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. LIVEKIT CLOUD WEBRTC (FREE TIER: 50 GB/Month)
# ------------------------------------------------------------------------------
# 1. Sign in at https://cloud.livekit.io/ with Google
# 2. Click "Create Project" -> Name it: TeamMeet
# 3. Go to Settings > Keys and copy these 3 credentials:
# (Note: LIVEKIT_URL must start with wss://)
LIVEKIT_URL=wss://yourteam-xxxxxx.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=secretxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 3. MEETING DURATION & RETENTION SETTINGS
# ------------------------------------------------------------------------------
# 24-Hour token duration ensures meetings never cut off at 90 minutes
TOKEN_TTL=24h

# Auto-Purge retention: server deletes recordings older than 15 days to save disk
PURGE_RETENTION_DAYS=15

# ------------------------------------------------------------------------------
# 4. OPTIONAL SECURITY & PASSCODE
# ------------------------------------------------------------------------------
# Optional passcode. If set, participants must enter this to join any meeting room.
# Leave blank for open team access without passcode.
TEAM_PASSCODE=

# ------------------------------------------------------------------------------
# 5. GOOGLE DRIVE AUTOMATIC SYNCHRONIZATION
# ------------------------------------------------------------------------------
# Provide a Google Drive folder link or folder ID. When configured (via .env,
# via the in-meeting UI 'Drive' button, or via Key Manager), all session artifacts:
#   - MP4 video recording (meeting.mp4)
#   - AI meeting notes markdown (notes.md)
#   - Timestamped attendance report (attendance.csv)
#   - Full speaker-attributed transcript (transcript.json)
# are automatically routed to that Google Drive folder.
# Example: https://drive.google.com/drive/folders/1AbCdEfGhIjKlMnOpQrStUvWxYz
GOOGLE_DRIVE_FOLDER_ID=

# Optional: For programmatic backend-to-backend Drive uploads without browser popups,
# provide your Google Service Account JSON key or OAuth2 Access Token:
GOOGLE_DRIVE_SERVICE_ACCOUNT_KEY=
# GOOGLE_DRIVE_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 6. AI MEETING NOTES & MULTI-PROVIDER LLM CONFIGURATION
# ------------------------------------------------------------------------------
# 'on' enables meeting transcription, AI summaries, and action item extraction.
# 'off' disables AI notes to save CPU.
AI_NOTES=on

# TeamMeet automatically detects and routes to your preferred AI engine:
# Priority order: GEMINI_API_KEY -> OPENAI_API_KEY -> GROQ_API_KEY -> LLM_BASE_URL (Ollama)
# Fallback: Built-in deterministic note-taking engine extracts commitments & decisions
# even if all external APIs are offline or unconfigured.

# Option A: Google Gemini (Recommended for speed & long-context meeting notes)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Option B: OpenAI (gpt-4o-mini / gpt-4o)
# OPENAI_API_KEY=

# Option C: Groq (ultra-low latency llama-3.3-70b-versatile)
# GROQ_API_KEY=

# Option D: Self-hosted / Local Ollama (Default: http://localhost:11434/v1)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b

# ------------------------------------------------------------------------------
# 7. WHISPER AUDIO TRANSCRIPTION WORKER
# ------------------------------------------------------------------------------
# Optional external self-hosted Whisper transcription service endpoint
WORKER_URL=http://localhost:8000
